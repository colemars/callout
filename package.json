{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm depcruise && turbo run typecheck test build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dependency-cruiser": "^16.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
